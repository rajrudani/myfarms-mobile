{
  "expo": {
    "name": "My Farms App",
    "slug": "myfarmsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myfarmsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.horizoncode.myfarmsapp",
      "infoPlist": {
        "NSCameraUsageDescription": "My Farms App requires access to your camera to capture receipts, weighment slips, and crop field observation photos.",
        "NSPhotoLibraryUsageDescription": "My Farms App requires access to your photo library to select invoices, receipts, and field observation photos.",
        "NSPhotoLibraryAddUsageDescription": "My Farms App requires permission to save photos and export reports to your library."
      }
    },
    "android": {
      "package": "com.horizoncode.myfarmsapp",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to attach invoices, receipts, and farm photos.",
          "cameraPermission": "The app accesses your camera to capture receipts and field observations."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
